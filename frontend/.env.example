# 后端API地址
VITE_API_BASE_URL=http://localhost:8000

# 高德地图Web API Key
VITE_AMAP_WEB_KEY=your_amap_web_api_key_here

# 高德地图Web端(JS API) Key(前端地图使用)
VITE_AMAP_WEB_JS_KEY=your_amap_web_js_key_here

# 高德地图Web端(JS API) 安全密钥
# 2021年12月02日后申请的Key必须配置,否则地图报 INVALID_USER_SCODE
# 获取方式:高德开放平台控制台 -> 应用管理 -> 我的应用 -> 添加Key
VITE_AMAP_WEB_JS_SECURITY_CODE=your_amap_web_js_security_code_here
